# ─────────────────────────────────────────────────────────────
# NSG Cotizador — Variables de Entorno
# Solo variables que el backend (src/) lee realmente.
# ─────────────────────────────────────────────────────────────

# ── Base de Datos PostgreSQL ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nsg_cotizaciones
DB_USER=postgres
DB_PASSWORD=
# En hosting gestionado suele requerirse: DB_SSL=true
DB_SSL=

# ── Seguridad ────────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
# En produccion: NODE_ENV=production
NODE_ENV=development
# En produccion: URL publica del frontend, ej. https://midominio.com
FRONTEND_URL=http://localhost:5173

# ── API Tipo de Cambio USD/PEN ──────────────────────────────
APIS_NET_TOKEN=

# ── API DNI (Decolecta) ─────────────────────────────────────
DECOLECTA_API_TOKEN=

# ── Asistente IA ────────────────────────────────────────────
# Proveedor activo del conversador: nvidia | gemini (defecto: nvidia)
IA_MODO_ACTIVO=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
# Gemini es fallback opcional; dejar vacio si no se usa
GEMINI_API_KEY=
GEMINI_MODEL=

# ── WhatsApp ────────────────────────────────────────────────
WHATSAPP_NUMERO_ASESOR=

# ── Correo SMTP (recuperacion de contrasena y notificaciones)
SMTP_HOST=
# Opcional: usar IP directa para evitar fallos DNS locales
SMTP_HOST_IP=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Icecat API (enriquecimiento de productos) ───────────────
# Credenciales de TU cuenta Icecat. NO usar el demo openIcecat-live.
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=
ICECAT_SHOPNAME=
ICECAT_APP_KEY=
ICECAT_LANG=

# ── Cloudflare Turnstile (captcha login/registro) ───────────
# Si TURNSTILE_SECRET_KEY esta vacio, la verificacion se omite (modo dev).
TURNSTILE_SECRET_KEY=

# ── Opcionales avanzadas (tienen valor por defecto en codigo) ─
# JWT_EXPIRACION=            duracion del token, ej. 8h
# DECOLECTA_DNI_URL=         endpoint alternativo para consulta DNI
# NVIDIA_FETCH_TIMEOUT_MS=   timeout del conversador NVIDIA
# GEMINI_TIMEOUT_MS=         timeout del conversador Gemini
# ICECAT_TIMEOUT_MS=         timeout de consultas a Icecat
# DELTRON_TIMEOUT_MS=        timeout de scraping a Deltron
# ENRIQUECIMIENTO_DELAY_DELTRON_MS=  delay entre requests a Deltron
# ENRIQUECIMIENTO_DELAY_ICECAT_MS=   delay entre requests a Icecat
